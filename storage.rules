rules_version = '2';

// Firebase Storage rules for the default bucket. Admin SDK (rotw-job, chef-backend) bypasses them.
service firebase.storage {
  match /b/{bucket}/o {

    // Recipe images. Public read: the app loads them through download URLs without a token
    // (Coil, ".../o/recipes%2F<uuid>.jpg?alt=media"). Older images use other names, hence **.
    match /recipes/{allPaths=**} {
      allow read: if true;
    }

    // Recipe images are generated and uploaded by chef-backend (Admin SDK) since 4.3.0 (CHE-61),
    // so clients have no write access to recipes/ at all.

    // Recipe-of-the-month videos are written by rotw-job (Admin SDK) and played via public URLs.
    match /videos/{allPaths=**} {
      allow read: if true;
    }

    // Everything else is denied.
  }
}
