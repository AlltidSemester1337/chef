{
  // READ-ONLY since the CHE-50 cut-over to Firestore (2026-10). All writes are rejected so app
  // versions <= 4.0.2 can no longer change data that now lives in Firestore. Reads stay as they were
  // for the 30-day safety window; after that the Realtime Database instance is deleted.
  "rules": {
    ".read": false,
    ".write": false,

    "recipes": {
      ".indexOn": ["uid"],
      ".read": "auth != null"
    },

    "recipe_variants": {
      "$recipeId": {
        ".read": "auth != null"
      }
    },

    "recipe_of_the_month": {
      ".read": true
    },

    "video_generation_history": {
      ".read": true
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    }
  }
}
