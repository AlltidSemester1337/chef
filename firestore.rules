rules_version = '2';

// Firestore port of database.rules.json (CHE-50). Same semantics; data model in .ai/firestore-schema.md.
// Admin SDK (rotw-job, migration script) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A recipe's uid may be the caller's or null (null = orphaned via removeRecipeUid).
    function uidIsCallerOrNull(data) {
      return data.get('uid', null) == null || data.uid == request.auth.uid;
    }

    match /recipes/{recipeId} {
      // Deliberately any signed-in user: the community-browse tab reads other users' favourites.
      allow read: if signedIn();
      allow create: if signedIn() && uidIsCallerOrNull(request.resource.data);
      allow update: if isUser(resource.data.get('uid', null)) && uidIsCallerOrNull(request.resource.data);
      allow delete: if isUser(resource.data.get('uid', null));

      // Variants have no owner field of their own — the parent recipe's owner writes them.
      match /variants/{variantId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && get(/databases/$(database)/documents/recipes/$(recipeId)).data.get('uid', null) == request.auth.uid;
      }
    }

    match /recipe_of_the_month/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /video_generation_history/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // betaInteractionCount is server-owned: chef-backend increments it with the Admin SDK
      // (which bypasses these rules), so clients may only leave it exactly as it is.
      // request.resource.data is the doc AFTER the write; resource is null on create.
      function betaCountUnchanged() {
        let before = resource == null ? null : resource.data.get('betaInteractionCount', null);
        return request.resource.data.get('betaInteractionCount', null) == before;
      }

      allow read: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['betaInteractionCount', 'preferences', 'cooking_resources'])
        && betaCountUnchanged();
      // Deleting the doc would reset the beta counter.
      allow delete: if false;

      match /{subcollection}/{docId} {
        allow read, write: if isUser(uid)
          && subcollection in ['chat_history', 'liked_messages', 'lists'];
      }
    }
  }
}
